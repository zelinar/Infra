terraform {
  required_providers {
    proxmox = {
      source = "telmate/proxmox"
      version = "= 3.0.2-rc03 "
    }
  }
}

 provider "proxmox" {
  pm_api_url      = "https://10.10.20.20:8006/api2/json"
  pm_api_token_id = "root@pam!root-token"
  pm_api_token_secret = "c399f294-89a9-4a90-a3c7-38ac066503e6"
#   pm_api_token_id = "terraform@pve!terraform-token"
#   pm_api_token_secret = "a5ab4f29-a815-4618-8e78-ce9c4c9a9f6e"
  pm_tls_insecure = true
}

resource "proxmox_vm_qemu" "ubuntu"{
  name        = "ubuntu-vm01"
  target_node = "homelab-server"
  clone       = "ubuntu24-server"   # cloud-init template name
  full_clone  = true
  agent       = 1
  skip_ipv6 = true
  

  cpu {
    cores   = 2
    sockets = 1
    type    = "host"
  }
  
  
  memory      = 21024
  scsihw      = "virtio-scsi-pci"
  bootdisk    = "scsi0"
  boot        = "order=scsi0"

  # Must specify root drive and cloudinit
  disks {
        ide {
            ide0 {
                cloudinit {
                    storage = "VM-storage"
                }
              }
        } 
        scsi {
          scsi0 {
             disk {
                size    = 25
                storage  = "VM-storage"
             }
            
                }      
             }  
        }
        
      
  network {
    id = 0
    model    = "virtio"
    bridge   = "vmbr0"
  }

  os_type = "cloud-init"
  #CIDR notation
  ipconfig0 = "ip=10.10.20.100/24,gw=10.10.20.1"

} 
  