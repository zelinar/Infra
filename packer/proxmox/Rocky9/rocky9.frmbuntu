# Rocky9 server 
# ---
# Packer config to create a Rocky9 template on Proxmox

# Proxmomx plugin - run packer init to install it
packer {
  required_plugins {
    name = {
      version = "~> 1"
      source  = "github.com/hashicorp/proxmox"
    }
  }
}


locals {
    disk_storage = var.disk_storage
}

# Resource Definiation for the VM Template
source "proxmox-iso" "rocky9" {

    # Proxmox Connection Settings
    proxmox_url = var.proxmox_api_url
    username    = var.proxmox_api_token_id
    token       = var.proxmox_api_token_secret

    # (Optional) Skip TLS Verification
    insecure_skip_tls_verify = var.skip_tls

    # VM General Settings
    node                 = var.proxmox_node
    vm_id                = var.vm_id
    vm_name              = var.template_name
    template_description = var.template_description

    # VM OS Settings
    # (Option 1) Local ISO File on proxmomx server
    boot_iso {
        type         = var.iso_type
        iso_file     = var.iso_file
        unmount      = var.unmount
        iso_checksum = var.iso_checksum
    # }
    # (Option 2) Download ISO
    # boot_iso {
    #     type             = "scsi"
    #     iso_url          = "https://releases.ubuntu.com/20.04/ubuntu-20.04.3-live-server-amd64.iso"
    #     unmount          = true
    #     iso_storage_pool = "local"
    #     iso_checksum     = "file:https://releases.ubuntu.com/focal/SHA256SUMS"
     }

    # VM System Settings
    qemu_agent = var.qemu_agent

    # VM HW Settings
    scsi_controller = var.scsi_controller
    disks {
        disk_size         = var.disk_size
        format            = var.disk_format
        storage_pool      = var.storage_pool
        type              = var.disk_type
    }
    # CPU and memory
    cores  = var.cpu_cores
    memory = var.memory

    # VM Network Settings
    network_adapters {
        model    = var.network_model
        bridge   = var.network_bridge
        firewall = var.firewall
    }

    # VM Cloud-Init Settings
    cloud_init              = var.cloud_init_enabled
    cloud_init_storage_pool = var.cloud_init_storage
    
    
    # PACKER Boot Commands
    #boot         = "c"
    boot_wait    = "5s"
    boot_command = [
        "e<wait>",
        # go to the kernel line (down to 'linux' line)
        "<down><down><down><end>",
        " inst.text inst.ks=http://{{ .HTTPIP }}:{{ .HTTPPort }}/ks.cfg",
        " console=tty0 console=ttyS0,115200n8",
        "<f10>"
       
       ]

    # Useful for debugging
    # Sometimes lag will require this
    # boot_key_interval = "500ms"

    # PACKER Autoinstall Settings
    http_directory = var.http_dir

    # (Optional) Bind IP Address and Port
      http_bind_address = var.http_ip
      http_port_min     = var.http_port_min
      http_port_max     = var.http_port_max

    ssh_username = var.ssh_username
    # (Option 1) Add your Password here
    ssh_password = var.ssh_psw 
    # Raise the timeout, when installation takes longer
    ssh_timeout = "20m"

    # - or -
    # (Option 2) Add your Private SSH KEY file here
    # ssh_private_key_file = "~/.ssh/id_rsa"

    
}

# Build Definition to create the VM Template
build {

    name    = "rocky9-server"
    sources = ["source.proxmox-iso.rocky9"]

    # Provisioning the VM Template for Cloud-Init Integration in Proxmox #1
    provisioner "shell" {
        inline = [
            #"echo 'network:\n  version: 2\n  ethernets:\n    ens18: {}' | echo 'Ansible-23!' | sudo -S tee /etc/netplan/50-cloud-init.yaml",
            #"echo 'Ansible-23!' | sudo -S netplan apply"
            "echo 'Ansible-23!' | sudo -S  rm -f /etc/netplan/50-cloud-init.yaml",
            "echo 'Ansible-23!' | sudo -S  cloud-init clean",
            "echo 'Ansible-23!' | sudo -S  truncate -s 0 /etc/machine-id"
        ]
    }

    # # Provisioning the VM Template for Cloud-Init Integration in Proxmox #2
    # provisioner "file" {
    #     source      = "files/99-pve.cfg"
    #     destination = "/tmp/99-pve.cfg"
    # }

    # # Provisioning the VM Template for Cloud-Init Integration in Proxmox #3
    # provisioner "shell" {
    #     inline = [ "sudo cp /tmp/99-pve.cfg /etc/cloud/cloud.cfg.d/99-pve.cfg" ]
    # }

    # Add additional provisioning scripts here
    # ...
}

